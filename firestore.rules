rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data :
        null;
    }

    function getUserRole() {
      let data = getUserData();
      return data != null && data.keys().hasAll(['role']) ? data.role : 'citizen';
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "nitesh933438@gmail.com" && request.auth.token.firebase.sign_in_provider == "google.com") ||
        (getUserData() != null && getUserRole() == "admin")
      );
    }

    function isResponder() {
      return isSignedIn() && (
        isAdmin() ||
        (getUserData() != null && getUserRole() in ["hospital", "police", "responder", "trainer", "volunteer"])
      );
    }

    function isOwnerDoc() {
      return resource != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (
        resource != null && (
          (resource.data.role in ["hospital", "police", "responder", "trainer"] && resource.data.verificationStatus == "VERIFIED") ||
          (resource.data.role == "volunteer" && (resource.data.approvalStatus == "Approved" || resource.data.verificationStatus == "VERIFIED"))
        )
      );
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'verificationStatus', 'approvalStatus', 'approved'])
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    // Incidents collection (Emergency/SOS data restricted to owner, responders, and admins)
    match /incidents/{incidentId} {
      allow read: if isSignedIn() && (isOwnerDoc() || isResponder() || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwnerDoc() || isResponder() || isAdmin());
      allow delete: if isAdmin();
    }

    // Emergencies collection (Restricted to owner, responders, and admins)
    match /emergencies/{emergencyId} {
      allow read: if isSignedIn() && (isOwnerDoc() || isResponder() || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwnerDoc() || isResponder() || isAdmin());
      allow delete: if isAdmin();
    }

    // sosRequests collection (Restricted to owner, responders, and admins)
    match /sosRequests/{sosId} {
      allow read: if isSignedIn() && (isOwnerDoc() || isResponder() || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwnerDoc() || isResponder() || isAdmin());
      allow delete: if isAdmin();
    }

    // Hierarchical Notifications collection
    match /notifications/{userId}/items/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin() || isResponder();
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    // Legacy Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isOwnerDoc() || isResponder() || isAdmin());
      allow create, update, delete: if isAdmin() || isResponder();
    }

    // Hazards collection (Public read for safety maps, authenticated create)
    match /hazards/{hazardId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwnerDoc() || isAdmin() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['latitude', 'longitude', 'type', 'severity', 'description', 'createdBy', 'userId'])
      );
      allow delete: if isAdmin() || isOwnerDoc();
    }

    // Community Posts collection
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn(); 
      allow delete: if isAdmin() || isOwnerDoc();
    }

    // Volunteers collection
    match /volunteers/{volunteerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        volunteerId == request.auth.uid || 
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.uid == request.auth.uid
      );
      allow update: if isAdmin() || (
        isSignedIn() && (
          volunteerId == request.auth.uid || 
          (resource != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid))
        ) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved', 'status', 'approvalStatus', 'trainingStatus', 'completedRescues', 'rating'])
        )
      );
      allow delete: if isAdmin();
    }

    // Training collection
    match /training/{trainingId} {
      allow read: if isSignedIn() && (isOwnerDoc() || isAdmin() || isResponder());
      allow create, update: if isOwner(trainingId) || isAdmin() || (isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Ride History collection
    match /rideHistory/{rideId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin() || isResponder());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Medical IDs collection
    match /medicalIDs/{docId} {
      allow read: if isOwner(docId) || isResponder() || isAdmin();
      allow create, update: if isOwner(docId) || isAdmin();
      allow delete: if isOwner(docId) || isAdmin();
    }

    // Audit Logs collection (Admin only)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
