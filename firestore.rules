rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "nitesh933438@gmail.com" && request.auth.token.firebase.sign_in_provider == "google.com") ||
        getUserRole() == "admin"
      );
    }

    function isResponder() {
      return isSignedIn() && (
        getUserRole() in ["admin", "hospital", "police", "volunteer", "responder", "trainer"]
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (
        resource != null && (
          (resource.data.role in ["hospital", "police", "responder", "trainer"] && resource.data.verificationStatus == "VERIFIED") ||
          (resource.data.role == "volunteer" && (resource.data.approvalStatus == "Approved" || resource.data.verificationStatus == "VERIFIED"))
        )
      );
      allow create: if isOwner(userId);
      // Enforce that users can only update their own profile and cannot self-verify or change role
      allow update: if (isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'verificationStatus', 'approvalStatus', 'approved'])
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    // Incidents collection
    match /incidents/{incidentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Emergencies collection
    match /emergencies/{emergencyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // sosRequests collection
    match /sosRequests/{sosId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Hierarchical Notifications collection
    match /notifications/{userId}/items/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin() || isResponder();
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    // Legacy Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isResponder();
    }

    // Hazards collection
    match /hazards/{hazardId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['latitude', 'longitude', 'type', 'severity', 'description', 'createdBy', 'userId'])
      );
      allow delete: if isAdmin();
    }

    // Community Posts collection
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Allow liking or adding comments
      allow delete: if isAdmin();
    }

    // Volunteers collection
    match /volunteers/{volunteerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        volunteerId == request.auth.uid || 
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.uid == request.auth.uid
      );
      allow update: if isAdmin() || (
        isSignedIn() && (
          volunteerId == request.auth.uid || 
          (resource != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid))
        ) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved', 'status', 'approvalStatus', 'trainingStatus', 'completedRescues', 'rating'])
        )
      );
      allow delete: if isAdmin();
    }

    // Training collection
    match /training/{trainingId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(trainingId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Ride History collection
    match /rideHistory/{rideId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Medical IDs collection
    match /medicalIDs/{docId} {
      allow read: if isOwner(docId) || isResponder() || isAdmin();
      allow create, update: if isOwner(docId) || isAdmin();
      allow delete: if isOwner(docId) || isAdmin();
    }

    // Audit Logs collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
