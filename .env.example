# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client-Side Configuration (Optional, falls back to firebase-applet-config.json)
# If you ignore firebase-applet-config.json in your public repository to prevent secret-scanning alerts,
# populate these variables in your hosting provider's dashboard (e.g. Vercel environment variables).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="goldenguard-7a8ee.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="goldenguard-7a8ee"
VITE_FIREBASE_STORAGE_BUCKET="goldenguard-7a8ee.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="364129436292"
VITE_FIREBASE_APP_ID="1:364129436292:web:ed797e2cdbddd83db878d1"
VITE_FIREBASE_MEASUREMENT_ID="G-H07B0LRX3Q"

# Cloudinary Integration (Optional, falls back to direct Base64 inline optimization if offline/missing)
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# Twilio SMS Emergency Dispatch Configuration (Optional, falls back to local console simulator if offline/missing)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+17372212163"
SMS_ACCOUNT_SID=""
SMS_AUTH_TOKEN=""
SMS_FROM_NUMBER=""
